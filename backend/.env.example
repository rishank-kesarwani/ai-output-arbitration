# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Public Demo Access Control
# Controls whether explicitly designated public/demo routes (e.g. /api/v1/seed/scenarios,
# /api/v1/arbitration/evaluate) accept anonymous requests without API key credentials.
# Set to "true" for public demo mode; set to "false" to enforce authentication on all endpoints.
# When disabled, requests to public/demo endpoints require x-api-key matching SERVICE_API_KEY.
# Protected mutations (POST /policies, POST /review-queue/:id/resolve, POST /arbitration/benchmark)
# always require valid SERVICE_API_KEY regardless of this setting.
PUBLIC_ACCESS_ENABLED=true

# Security & CORS
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_backend_jwt_secret_placeholder_min_32_chars
SERVICE_API_KEY=your_arbitration_service_api_key_placeholder

# Downstream Shared Services (Optional / Resiliently Handled)
AI_PLATFORM_URL=http://localhost:4001
AI_PLATFORM_API_KEY=placeholder_ai_platform_key_here
AI_PLATFORM_TIMEOUT_MS=5000

NOTIFICATION_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_API_KEY=placeholder_notification_service_key_here
NOTIFICATION_SERVICE_TIMEOUT_MS=5000

MODEL_REGRESSION_SERVICE_URL=http://localhost:4003
MODEL_REGRESSION_SERVICE_API_KEY=placeholder_regression_service_key_here
MODEL_REGRESSION_SERVICE_TIMEOUT_MS=5000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
