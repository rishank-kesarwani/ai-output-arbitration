# Frontend Public Environment Variables
# NOTE: NEXT_PUBLIC_* variables are embedded into the client-side JavaScript bundle
# at Next.js build time. Changing these variables on Vercel requires a redeployment/rebuild.

# API Base URL (Direct-Backend Strategy)
# Represents the complete API base URL expected by the API client including the route prefix.
# Local development default: http://localhost:4000/api/v1
# In production on Vercel, set to your Render backend API base URL:
# e.g., https://ai-output-arbitration-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Frontend Public/Demo Access Toggle
# Controls visibility and enabling of public demo evaluation actions in the UI.
# Setting to "false" disables interactive evaluations and displays an access notice.
# Note: Backend enforces independent security control via PUBLIC_ACCESS_ENABLED.
NEXT_PUBLIC_ACCESS_ENABLED=true

# Vercel Image Optimization Quota Protection (Optional)
# Set to "true" to globally bypass Vercel's serverless Image Optimization endpoint (/_next/image).
# Useful when the team has reached its monthly included 5,000 transformation allowance to prevent HTTP 402 errors.
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=false
